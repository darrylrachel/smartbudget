# Foundation uses mock repositories and needs no environment variables.
# This template contains no active credentials.
# Future optional client integration; enable only in the backend phase.
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# EXPO_PUBLIC_* values ship with the app and are visible to users.
# Never put service-role keys, database passwords, or private tokens here.
